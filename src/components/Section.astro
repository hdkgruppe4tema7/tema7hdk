---
const { title, subtitle, color, bgcolor, height } = Astro.props;
---

<section class="Section"
  style=`background-color: ${bgcolor}; color: ${color}; height: ${height};`
>
  <h2>{title}</h2>
  <h3>{subtitle}</h3>
  
  <slot />
</section>

<style>
  section {
    padding-top: 4rem;
    /* padding-bottom: 4rem; */
    text-align: center;
    color: black;
    background-color: white;
  }
  h2{
    font-size: 2.5rem;
  }
  h3{
    font-weight: 400;
  }
 
</style>