<style>

/* =========================
   FORM LAYOUT
========================= */

.form{
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.formsection {
  background-color: #F2EFEF;
  padding: 3rem;
}


#webform {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.2rem;
  margin: 3rem;

}
#webform h2,
#webform legend,
#webform fieldset,
.submit-button {
  grid-column: 1 / -1;
}



/* Telefon + Email side-by-side */
.contact-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.2rem;
}

/* =========================
   FORM SUMMARY
========================= */

#form-summary{
  background-color: #F2EFEF;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  margin: 3rem;
  border-radius: 25px;
}

/* =========================
   FORM ELEMENTS
========================= */

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.form-group label {
  font-weight: 500;
}

/* Required star */
.form-group:has(:required) label::after {
  content: " *";
  color: rgb(207, 22, 22);
}

/* Invalid styling */
.form-group:has(:user-invalid) input {
  outline: 2px solid #f005;
  border-color: darkred;
}

/* Inputs */
input[type="text"],
input[type="tel"],
input[type="email"] {
  padding: 0.7rem 1rem;
  border-radius: 8px;
  border: 1px solid #ccc;
  font-size: 1rem;
  transition: 0.2s ease;
}

input:focus {
  border-color: #e5c4a0;
  outline: none;
}

/* Radio + Checkbox */
.fieldset-group {
  margin-bottom: 0.4rem;
}

.fieldset-group label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
}

input[type="radio"],
input[type="checkbox"] {
  accent-color: #d68227;
}

/* =========================
   FIELDSET
========================= */

fieldset {
  border: none;
  padding: 0;
}

legend {
  font-weight: 600;
  margin-bottom: 6px;
}

/* =========================
   SUBMIT BUTTON
========================= */

.submit-button {
  border-radius: 8px;
  background: linear-gradient(135deg, #e5c4a0, #e48e48);
  padding: 0.8rem;
  border: none;
  font-size: 1rem;
  font-weight: 600;
  color: white;
  transition: 0.3s;
  grid-column: 1 / -1; /* Går over begge kolonner */
}

.submit-button:hover {
  cursor: pointer;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
}

/* =========================
   ONLINE INFO SECTION
========================= */

#onlineinfo{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  background-color: #F8E6D9;
  padding-top: 4rem;
  padding-bottom: 3rem;
}

#onlineinfo h2{
  font-size: 2.5rem;
}

#onlineinfo h3{
  font-weight: bold;
}

.onlineinfotekst{
  display: flex;
  flex-direction: column;
  padding-left: 10rem;
}

.onlineinfotekst p, li{
  max-width: 900px;
}

/* =========================
   CAROUSEL
========================= */

.carousel {
  max-width: 650px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
}

.track {
  display: flex;
}

.track img {
  flex: 0 0 100%;
  scroll-snap-align: center;
  width: 100%;
  height: 60vh;
  object-fit: cover;
  border-radius: 15px;
}

/* =========================
   SCROLL ICON
========================= */

.scroll-hint {
  color: rgb(255, 115, 0);
  padding-left: 100%;
  font-size: 6rem;
  display: inline-block;
  animation: bounceY 1s ease-in-out infinite;
}

@keyframes bounceY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(10px); }
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 900px) {

  .form {
    grid-template-columns: 1fr;
  }

  #onlineinfo {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .onlineinfotekst {
    padding: 2rem;
  }

  .contact-row {
    grid-template-columns: 1fr;
  }

}

</style>
