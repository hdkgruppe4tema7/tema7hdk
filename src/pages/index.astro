---
import Layout from "../layouts/Layout.astro";
import "../css/main.css";
import "../css/header&footer.css";
import Button from "../components/Buttons.astro";
import Card from "../components/Card.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";

---

<Layout>
	
 <Hero id="herotext"
  title="Dit højskoleeventyr starter her"
  subtitle="HØJSKOLENDK er en dansk højskole for unge i alderen 18-26 år. 
  Vi brænder for oplevelser, fællesskabet og det gode eventyr."
  bgimage="hero.jpg"
>
  <Button text="Se rejsekalender" variant="orange" />
  <Button text="Infomøder" variant="white"/>
</Hero>


<Section id="forside"
title="Vælg dit eventyr" subtitle="HØJSKOLENDK er en dansk højskole for unge i alderen 18-26 år. Vi brænder for oplevelser, fællesskabet og det gode eventyr."/>

<div class="cardsgrid">
<Card
subline="Maldiverne"
byline="Se afgange"
image="images/maldiverne.jpeg"
span="2"
/>

<Card
subline="Brasilien"
byline="Se afgange"
image="images/brasilien.jpg"
span="2"
/>

<Card
subline="Australien"
byline="Se afgange"
image="images/australien.jpeg"
span="2"
/>

<Card
subline="Hawaii"
byline="Se afgange"
image="images/hawaii.jpeg"
span="3"
/>

<Card
subline="Sri Lanka"
byline="Se afgange"
image="images/srilanka.jpeg"
span="3"
/>
</div>
<div class ="knapindex">
<Button text="Se alle rejser" variant="orange"/>
</div>



<Section 
  title="Oplevelser for livet og fantastiske eventyr"
subtitle="Tjek vores instagram for at se, hvad du kan oppleve på et højskoleophold med os"
  bgcolor="#D5E7EE"
>
<div class="video-links">
  <a href="https://youtube.com/shorts/5HFGs8ja_sg" target="_blank">
    <img src="/public/images/tiktok2.png" alt="Video 1">
  </a>

  <a href="https://youtube.com/shorts/vehM3Re-Isg" target="_blank">
    <img src="/public/images/tiktok1.png" alt="Video 2">
  </a>
</div>
  <div class ="knapindex">
<div class="knapindex">
  <a href="https://www.instagram.com/hojskolendk" target="_blank">
    <Button text="Tjek vores Instagram" variant="orange" />
  </a>
</div>
</div>
</Section>



<Section title="+3.000 glade elever siden 2010" subtitle="96% af alle elever anbefaler HØJSKOLENDK (2025)"/>

<Section title="Klar på højskoleeventyr, fællesskab & masser af adventure?" subtitle="Her er lidt af det, som du får, når du tager på et højskoleophold med os" bgcolor="#F8E6D9"/>

<Section title="Kom til infomøde" subtitle="Kig forbi et af vores hyggelige online-infomøder - vi glæder os til at møde dig"
	
/>
<div class ="knapindex">
<Button text="Tilmeld infomøde" variant="orange" />
</div>
<Section title="Historier fra elever" subtitle="HØJSKOLENDK er en dansk højskole for unge i alederen 18-29 år. Vi brænder for oplevelser, fællesskabet og det gode eventyr." bgcolor="#D5E7EE"
/>
<div class ="knapindex">
<Button text="Læs flere historier" variant="orange" />
</div>
<Section title="Et fællesskab, der starter på rejsen og varer hele livet"
/>

</Layout>


<style>
#herotext{}



.herobtn{
display: flex;
flex-direction: row;
text-align: center;
align-items: center;
justify-content: center;
padding-top: 1rem;

}

.cardsgrid{
    display: grid;
	grid-template-columns: repeat(6, 1fr);
	gap: 1rem;
	margin: 5rem;
}


.forside{
	text-align: center;
	max-width: 1200px;
}
.knapindex{
  display: flex;
  justify-content: center;
  margin: 3rem 0;
}

.video-links {
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin: 4rem auto;
}

.video-links img {
  width: 280px;
  border-radius: 14px;
  transition: transform 0.2s ease;
  cursor: pointer;
}

.video-links img:hover {
  transform: scale(1.05);
}



</style>